+            async def __aenter__(self):
+                raise weixin.aiohttp.ClientConnectionError("temporary CDN failure")
+
+            async def __aexit__(self, exc_type, exc, tb):
+                return False
+
+        class _RetryingSession:
+            def __init__(self):
+                self.calls = 0
