+def _compose_text_image_for_weixin(content: str, image_path: str) -> str:
+    """Render text above an image because iLink rejects mixed item payloads."""
+    from PIL import Image, ImageDraw, ImageFont
+
+    plain = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", content or "")
+    plain = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", plain)
+    plain = re.sub(r"(?m)^\s*#{1,6}\s*", "", plain)
+    plain = re.sub(r"(?m)^\s*[-*+]\s+", "• ", plain)
+    plain = plain.replace("**", "").replace("__", "").replace("`", "").strip()
+
+    source = Image.open(image_path).convert("RGB")
+    margin = 64
+    canvas_width = max(960, min(1600, source.width + margin * 2))
+    available_width = canvas_width - margin * 2
+    if source.width > available_width:
+        ratio = available_width / source.width
+        source = source.resize(
+            (available_width, max(1, round(source.height * ratio))),
+            Image.Resampling.LANCZOS,
+        )
+
+    font = None
+    for font_path in (
+        "/System/Library/Fonts/PingFang.ttc",
+        "/System/Library/Fonts/STHeiti Medium.ttc",
+        "/System/Library/Fonts/Supplemental/Arial Unicode.ttf",
+        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
+        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
+    ):
+        try:
+            font = ImageFont.truetype(font_path, 40)
+            break
+        except (OSError, ValueError):
+            continue
+    font = font or ImageFont.load_default()
+    probe = ImageDraw.Draw(Image.new("RGB", (1, 1)))
+
+    lines: List[str] = []
+    for paragraph in plain.splitlines() or [""]:
+        if not paragraph:
+            lines.append("")
+            continue
+        current = ""
+        for char in paragraph:
+            candidate = current + char
+            box = probe.textbbox((0, 0), candidate, font=font)
+            if current and box[2] - box[0] > available_width:
+                lines.append(current)
+                current = char
+            else:
+                current = candidate
+        lines.append(current)
+
+    line_height = 58
+    text_height = margin + max(1, len(lines)) * line_height + 44
+    canvas = Image.new(
+        "RGB", (canvas_width, text_height + source.height + margin), "white"
+    )
+    draw = ImageDraw.Draw(canvas)
+    y = margin
+    for line in lines:
+        if line:
+            draw.text((margin, y), line, font=font, fill=(20, 20, 20))
+        y += line_height
+    draw.line(
+        (margin, text_height - 20, canvas_width - margin, text_height - 20),
+        fill=(220, 220, 220), width=2,
+    )
+    canvas.paste(source, ((canvas_width - source.width) // 2, text_height))
+
+    handle = tempfile.NamedTemporaryFile(
+        prefix="hermes-weixin-card-", suffix=".png", delete=False
+    )
+    handle.close()
+    canvas.save(handle.name, format="PNG", optimize=True)
+    return handle.name
+
