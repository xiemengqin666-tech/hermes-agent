+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+from gateway.config import Platform
+from gateway.run_turn_runner import TurnRunner
+
+
+def test_channel_compression_override_updates_live_compressor():
+    compressor = SimpleNamespace(
+        threshold_percent=0.85,
+        threshold_tokens=231_200,
+        tail_token_budget=46_240,
+        summary_target_ratio=0.2,
+        context_length=272_000,
+        protect_last_n=10,
+    )
+    agent = SimpleNamespace(context_compressor=compressor)
+    ctx = SimpleNamespace(
+        source=SimpleNamespace(
+            chat_id="mechanical-arm", thread_id=None, user_id="user", user_id_alt=None,
+        ),
+        user_config={
+            "platforms": {
+                "feishu": {
+                    "extra": {
+                        "channel_compression_overrides": {
+                            "mechanical-arm": {"threshold": 0.5, "protect_last_n": 14},
+                        },
+                    },
+                },
+            },
+        },
+    )
+
+    TurnRunner(SimpleNamespace(), ctx)._apply_channel_compression_override(agent, "feishu")
+
+    assert compressor.threshold_percent == 0.5
+    assert compressor.threshold_tokens == 136_000
+    assert compressor.tail_token_budget == 27_200
+    assert compressor.protect_last_n == 14
+
+
+def test_feishu_stream_footer_is_attached_before_finalize(monkeypatch):
+    formatter = MagicMock(return_value="已完成 · 耗时 1.2s · gpt-5.6")
+    consumer = SimpleNamespace(
+        adapter=SimpleNamespace(format_stream_footer=formatter),
+        set_final_metadata=MagicMock(),
+    )
+    agent = SimpleNamespace(
+        context_compressor=SimpleNamespace(last_prompt_tokens=19_000, context_length=272_000),
+        session_prompt_tokens=20_000,
+        session_completion_tokens=145,
+        session_cache_read_tokens=18_000,
+        session_cache_write_tokens=1_000,
+        model="openai-codex/gpt-5.6",
+    )
+    ctx = SimpleNamespace(
+        source=SimpleNamespace(platform=Platform.FEISHU),
+        user_config={"display": {"platforms": {"feishu": {"runtime_footer": {"enabled": True}}}}},
+        agent_holder=[agent],
+        agent_run_started_at=0,
+    )
+    monkeypatch.setattr("gateway.runtime_footer.resolve_footer_config", lambda *_args: {"enabled": True})
+
+    attached = TurnRunner(SimpleNamespace(), ctx)._attach_stream_footer(
+        {"failed": False}, consumer
+    )
+
+    assert attached is True
+    consumer.set_final_metadata.assert_called_once_with(
+        feishu_stream_footer="已完成 · 耗时 1.2s · gpt-5.6"
+    )
+    assert formatter.call_args.kwargs["cache_read_tokens"] == 18_000
+    assert formatter.call_args.kwargs["cache_write_tokens"] == 1_000
