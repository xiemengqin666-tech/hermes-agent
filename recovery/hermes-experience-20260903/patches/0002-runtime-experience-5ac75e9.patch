+class _InlineProgressAdapter:
+    STREAM_PROGRESS_IN_CONTENT = True
+    REQUIRES_EDIT_FINALIZE = True
+    MAX_MESSAGE_LENGTH = 8000
+
+    def __init__(self):
+        self.sent = []
+        self.edited = []
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        self.sent.append({
+            "chat_id": chat_id, "content": content, "reply_to": reply_to,
+            "metadata": metadata,
+        })
+        return SimpleNamespace(success=True, message_id="card-message")
+
+    async def edit_message(
+        self, chat_id, message_id, content, *, finalize=False, metadata=None,
+    ):
+        self.edited.append({
+            "chat_id": chat_id, "message_id": message_id, "content": content,
+            "finalize": finalize, "metadata": metadata,
+        })
+        return SimpleNamespace(success=True, message_id=message_id)
+
+
+class TestInlineProgressStream:
+    @pytest.mark.asyncio
+    async def test_progress_and_answer_share_one_message_then_finalize_body_only(self):
+        adapter = _InlineProgressAdapter()
+        consumer = GatewayStreamConsumer(
+            adapter, "chat", StreamConsumerConfig(edit_interval=0, buffer_threshold=1, cursor=""),
+            initial_reply_to_id="user-message",
+        )
+        task = asyncio.create_task(consumer.run())
+
+        consumer.on_tool_progress("```shell\npython check.py\n```")
+        await asyncio.sleep(0.08)
+        consumer.on_delta("正在整理")
+        await asyncio.sleep(0.08)
+        consumer.set_final_metadata(feishu_stream_footer="已完成 · gpt-5.6")
+        consumer.finish("最终正文")
+        await asyncio.wait_for(task, timeout=2)
+
+        assert len(adapter.sent) == 1
+        assert adapter.sent[0]["reply_to"] == "user-message"
+        assert adapter.sent[0]["metadata"]["expect_edits"] is True
+        assert "```" not in adapter.sent[0]["content"]
+        assert "python check.py" in adapter.sent[0]["content"]
+        assert any(
+            "最近进度" in call["content"]
+            and call["content"].index("python check.py") < call["content"].index("回复")
+            and "正在整理" in call["content"]
+            for call in adapter.edited
+            if not call["finalize"]
+        )
+        assert adapter.edited[-1]["finalize"] is True
+        assert adapter.edited[-1]["content"] == "最终正文"
+        assert adapter.edited[-1]["metadata"]["feishu_stream_footer"] == "已完成 · gpt-5.6"
+
+    def test_progress_keeps_only_recent_sanitized_lines(self):
+        consumer = GatewayStreamConsumer(_InlineProgressAdapter(), "chat")
+        for index in range(9):
+            consumer._update_inline_progress(f"```text\nline {index}\n```")
+        rendered = consumer._compose_inline_content()
+
+        assert "```" not in rendered
+        assert "line 0" not in rendered
+        assert "line 2" not in rendered
+        assert "line 3" in rendered
+        assert "line 8" in rendered
+        assert rendered.count("• ") == 6
+
