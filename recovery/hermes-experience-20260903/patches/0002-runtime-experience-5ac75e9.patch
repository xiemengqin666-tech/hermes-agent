+def _synchronous_platform_requested(cfg: Dict[str, Any]) -> str:
+    """Return the current gateway platform when config keeps delegation in-band."""
+    raw_sync_platforms = cfg.get("synchronous_platforms") or []
+    if isinstance(raw_sync_platforms, str):
+        raw_sync_platforms = raw_sync_platforms.split(",")
+    sync_platforms = (
+        {
+            str(item).strip().lower()
+            for item in raw_sync_platforms
+            if str(item).strip()
+        }
+        if isinstance(raw_sync_platforms, (list, tuple, set))
+        else set()
+    )
+    try:
+        from gateway.session_context import get_session_env
+
+        current_platform = get_session_env(
+            "HERMES_SESSION_PLATFORM", ""
+        ).strip().lower()
+    except Exception:
+        current_platform = ""
+    return current_platform if current_platform in sync_platforms else ""
+
