diff --git a/hermes_cli/companion_cli_updates.py b/hermes_cli/companion_cli_updates.py
new file mode 100644
index 0000000000000000000000000000000000000000..23b2c54876de3b55c40515da05f9b68b3fb63b22
--- /dev/null
+++ b/hermes_cli/companion_cli_updates.py
@@ -0,0 +1,281 @@
+"""Update installed command-line companions used alongside Hermes."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Callable, Mapping, Optional
+
+
+_RUNTIME_PACKAGE_EXCLUSIONS = {
+    # This package is the live Feishu gateway plugin, not merely a CLI. It has
+    # its own compatibility lifecycle and must not be swept up by generic CLI
+    # updates just because it exposes an installer binary.
+    "@colinlu50/openclaw-lark-stream",
+}
+
+
+def companion_cli_updates_enabled() -> bool:
+    try:
+        from hermes_cli.config import load_config
+
+        updates = (load_config() or {}).get("updates", {})
+        value = updates.get("update_companion_clis", False) if isinstance(updates, dict) else False
+    except Exception:
+        return False
+    if isinstance(value, str):
+        return value.strip().lower() not in {"0", "false", "no", "off"}
+    return bool(value)
+
+
+def _npm_root(npm: str, run: Callable = subprocess.run) -> Optional[Path]:
+    result = run([npm, "root", "-g"], capture_output=True, text=True, check=False)
+    if result.returncode != 0 or not result.stdout.strip():
+        return None
+    return Path(result.stdout.strip())
+
+
+def discover_outdated_npm_clis(
+    *,
+    npm: str,
+    npm_root: Optional[Path] = None,
+    run: Callable = subprocess.run,
+) -> dict[str, Mapping[str, object]]:
+    """Return outdated global npm packages that actually expose CLI bins."""
+    result = run(
+        [npm, "outdated", "-g", "--json"],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    raw = result.stdout.strip() or "{}"
+    try:
+        payload = json.loads(raw)
+    except json.JSONDecodeError:
+        return {}
+    if not isinstance(payload, dict):
+        return {}
+
+    root = Path(npm_root) if npm_root is not None else _npm_root(npm, run=run)
+    if root is None:
+        return {}
+    discovered: dict[str, Mapping[str, object]] = {}
+    for name, metadata in payload.items():
+        if name in _RUNTIME_PACKAGE_EXCLUSIONS or not isinstance(metadata, dict):
+            continue
+        manifest = root / name / "package.json"
+        try:
+            package = json.loads(manifest.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError):
+            continue
+        if package.get("bin"):
+            discovered[name] = metadata
+    return discovered
+
+
+def sync_lark_skills_state(state_path: Path, version: str) -> None:
+    """Stamp lark's state file after the official skills installer succeeds."""
+    path = Path(state_path)
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return
+    if not isinstance(payload, dict):
+        return
+    payload["version"] = version
+    payload["updated_at"] = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp_name = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(payload, handle, ensure_ascii=False, indent=2)
+            handle.write("\n")
+        os.replace(tmp_name, path)
+    except Exception:
+        try:
+            os.unlink(tmp_name)
+        except OSError:
+            pass
+        raise
+
+
+def _tail(result: subprocess.CompletedProcess[str]) -> str:
+    text = (result.stderr or result.stdout or "").strip().splitlines()
+    return text[-1] if text else f"exit {result.returncode}"
+
+
+def _run(
+    command: list[str],
+    *,
+    env: dict[str, str],
+    timeout: int = 600,
+) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        command,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=timeout,
+        env=env,
+    )
+
+
+def _lark_version(lark: str, env: dict[str, str]) -> str:
+    result = _run([lark, "--version"], env=env, timeout=30)
+    match = re.search(r"(\d+\.\d+\.\d+)", result.stdout or result.stderr or "")
+    return match.group(1) if match else ""
+
+
+def _ensure_lark_skills_synced(
+    *,
+    lark: str,
+    npx: Optional[str],
+    env: dict[str, str],
+) -> None:
+    check = _run([lark, "update", "--check", "--json"], env=env, timeout=120)
+    try:
+        payload = json.loads(check.stdout or "{}")
+    except json.JSONDecodeError:
+        payload = {}
+    skills = payload.get("skills_status", {}) if isinstance(payload, dict) else {}
+    if check.returncode == 0 and isinstance(skills, dict) and skills.get("in_sync") is not False:
+        return
+    if not npx:
+        raise RuntimeError("lark-cli Skills are out of sync and npx is unavailable")
+    install = _run([npx, "-y", "skills", "add", "larksuite/cli", "-y", "-g"], env=env)
+    if install.returncode != 0:
+        raise RuntimeError(f"lark-cli Skills sync failed: {_tail(install)}")
+    version = _lark_version(lark, env)
+    if version:
+        sync_lark_skills_state(Path.home() / ".lark-cli" / "skills-state.json", version)
+    verify = _run([lark, "update", "--check", "--json"], env=env, timeout=120)
+    try:
+        verified = json.loads(verify.stdout or "{}")
+    except json.JSONDecodeError:
+        verified = {}
+    verified_skills = verified.get("skills_status", {}) if isinstance(verified, dict) else {}
+    if verify.returncode != 0 or not isinstance(verified_skills, dict) or not verified_skills.get("in_sync"):
+        raise RuntimeError("lark-cli Skills remain out of sync after reinstall")
+
+
+def _ensure_agent_browser_entrypoint(
+    *,
+    npm: str,
+    env: dict[str, str],
+) -> bool:
+    """Repair the dangling global shim that `hermes update` can leave behind."""
+    root = _npm_root(npm)
+    manifest = root / "agent-browser" / "package.json" if root else None
+    executable = shutil.which("agent-browser")
+    # Current Hermes resolves agent-browser lazily through npx. Do not turn a
+    # chat-triggered update into an implicit global install on machines that do
+    # not already carry it (and, in particular, do not acquire a browser
+    # runtime as a side effect). Existing global installs are still repaired.
+    if not executable and not (manifest and manifest.is_file()):
+        return False
+    if manifest and manifest.is_file() and executable:
+        verify = _run([executable, "--version"], env=env, timeout=30)
+        if verify.returncode == 0:
+            return False
+
+    no_browser_env = dict(env)
+    no_browser_env["npm_config_ignore_scripts"] = "true"
+    repair = _run(
+        [npm, "install", "-g", "agent-browser@latest"],
+        env=no_browser_env,
+    )
+    if repair.returncode != 0:
+        raise RuntimeError(f"agent-browser entrypoint repair failed: {_tail(repair)}")
+    executable = shutil.which("agent-browser")
+    if not executable:
+        raise RuntimeError("agent-browser entrypoint remains unavailable after repair")
+    verify = _run([executable, "--version"], env=env, timeout=30)
+    if verify.returncode != 0:
+        raise RuntimeError(f"agent-browser remains unusable after repair: {_tail(verify)}")
+    return True
+
+
+def update_companion_clis(*, print_fn: Callable[[str], None] = print) -> list[str]:
+    """Update every outdated installed npm CLI, with tool-specific guards."""
+    npm = shutil.which("npm")
+    if not npm:
+        raise RuntimeError("npm is unavailable; companion CLIs cannot be checked")
+    npx = shutil.which("npx")
+    env = dict(os.environ)
+    env["LARKSUITE_CLI_NO_UPDATE_NOTIFIER"] = "1"
+    env["LARKSUITE_CLI_NO_SKILLS_NOTIFIER"] = "1"
+    outdated = discover_outdated_npm_clis(npm=npm)
+    updated: list[str] = []
+
+    # npm updates its own executable tree, so update it after every other CLI.
+    for package in sorted(outdated, key=lambda item: item == "npm"):
+        print_fn(f"  → Updating {package}...")
+        if package == "@openai/codex" and shutil.which("codex"):
+            result = _run([shutil.which("codex") or "codex", "update"], env=env)
+            if result.returncode != 0:
+                result = _run([npm, "install", "-g", f"{package}@latest"], env=env)
+        elif package == "@larksuite/cli" and shutil.which("lark-cli"):
+            lark = shutil.which("lark-cli") or "lark-cli"
+            result = _run([lark, "update", "--json"], env=env)
+            if result.returncode != 0:
+                result = _run([npm, "install", "-g", f"{package}@latest"], env=env)
+        elif package == "agent-browser":
+            no_browser_env = dict(env)
+            no_browser_env["npm_config_ignore_scripts"] = "true"
+            result = _run([npm, "install", "-g", f"{package}@latest"], env=no_browser_env)
+        else:
+            result = _run([npm, "install", "-g", f"{package}@latest"], env=env)
+        if result.returncode != 0:
+            raise RuntimeError(f"{package} update failed: {_tail(result)}")
+
+        if package == "@anthropic-ai/claude-code" and shutil.which("claude"):
+            verify = _run([shutil.which("claude") or "claude", "--version"], env=env, timeout=30)
+            if verify.returncode != 0:
+                root = _npm_root(npm)
+                installer = root / package / "install.cjs" if root else None
+                node = shutil.which("node")
+                if not installer or not installer.is_file() or not node:
+                    raise RuntimeError("Claude Code native binary is missing after update")
+                install_native = _run([node, str(installer)], env=env, timeout=300)
+                if install_native.returncode != 0:
+                    raise RuntimeError(f"Claude Code native install failed: {_tail(install_native)}")
+        updated.append(package)
+
+    lark = shutil.which("lark-cli")
+    if lark:
+        _ensure_lark_skills_synced(lark=lark, npx=npx, env=env)
+
+    if _ensure_agent_browser_entrypoint(npm=npm, env=env):
+        if "agent-browser" not in updated:
+            updated.append("agent-browser")
+        print_fn("  ✓ Repaired agent-browser CLI entrypoint (Chromium install skipped)")
+
+    remaining = discover_outdated_npm_clis(npm=npm)
+    if remaining:
+        raise RuntimeError("CLI updates remain pending: " + ", ".join(remaining))
+    if updated:
+        print_fn(f"  ✓ Updated {len(updated)} companion CLI(s)")
+    else:
+        print_fn("  ✓ Companion CLIs are up to date")
+    return updated
+
+
+def maybe_update_companion_clis(gateway_mode: bool) -> list[str]:
+    """Update companion CLIs only for chat-triggered update runs."""
+    if not gateway_mode or not companion_cli_updates_enabled():
+        return []
+    print("\n→ Updating companion CLIs...")
+    try:
+        return update_companion_clis()
+    except Exception as exc:
+        # A companion registry outage must not strand Hermes halfway through
+        # its own update. The warning is streamed into the existing /update
+        # card so the operator can retry without receiving an opaque crash.
+        print(f"  ⚠ Companion CLI update incomplete: {exc}")
+        return []
