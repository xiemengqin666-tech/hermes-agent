+def test_discover_outdated_npm_clis_keeps_only_real_cli_packages(tmp_path: Path):
+    root = tmp_path / "node_modules"
+    cli_dir = root / "example-cli"
+    library_dir = root / "example-library"
+    excluded_dir = root / "@colinlu50" / "openclaw-lark-stream"
+    cli_dir.mkdir(parents=True)
+    library_dir.mkdir(parents=True)
+    excluded_dir.mkdir(parents=True)
+    (cli_dir / "package.json").write_text(
+        json.dumps({"bin": {"example": "bin/example.js"}}), encoding="utf-8"
+    )
+    (library_dir / "package.json").write_text(
+        json.dumps({"name": "example-library"}), encoding="utf-8"
+    )
+    (excluded_dir / "package.json").write_text(
+        json.dumps({"bin": {"lark-stream": "bin/install.js"}}), encoding="utf-8"
+    )
+    payload = {
+        "example-cli": {"current": "1.0.0", "latest": "2.0.0"},
+        "example-library": {"current": "1.0.0", "latest": "2.0.0"},
+        "@colinlu50/openclaw-lark-stream": {
+            "current": "1.0.0",
+            "latest": "2.0.0",
+        },
+    }
+    run = Mock(
+        return_value=subprocess.CompletedProcess(
+            args=[], returncode=1, stdout=json.dumps(payload), stderr=""
+        )
+    )
+
+    discovered = companion.discover_outdated_npm_clis(
+        npm="npm", npm_root=root, run=run
+    )
+
+    assert list(discovered) == ["example-cli"]
+
+
+def test_missing_agent_browser_is_not_installed_implicitly(tmp_path: Path):
+    with (
+        patch.object(companion, "_npm_root", return_value=tmp_path),
+        patch.object(companion.shutil, "which", return_value=None),
+        patch.object(companion, "_run") as run,
+    ):
+        repaired = companion._ensure_agent_browser_entrypoint(
+            npm="npm", env={}
+        )
+
+    assert repaired is False
+    run.assert_not_called()
+
+
+def test_companion_failure_does_not_abort_hermes_update(capsys):
+    with (
+        patch.object(companion, "companion_cli_updates_enabled", return_value=True),
+        patch.object(
+            companion,
+            "update_companion_clis",
+            side_effect=RuntimeError("registry unavailable"),
+        ),
+    ):
+        result = companion.maybe_update_companion_clis(gateway_mode=True)
+
+    assert result == []
+    output = capsys.readouterr().out
+    assert "Companion CLI update incomplete" in output
+    assert "registry unavailable" in output
+
+
+def test_companion_update_is_skipped_outside_gateway_mode():
+    with patch.object(companion, "update_companion_clis") as update:
+        assert companion.maybe_update_companion_clis(gateway_mode=False) == []
+
+    update.assert_not_called()
+
+
+def test_update_pipeline_keeps_companion_callable_across_checkout(monkeypatch):
+    """The running updater must retain its helper after source replacement."""
+    bound = update_cmd._maybe_update_companion_clis
+    monkeypatch.delitem(sys.modules, "hermes_cli.companion_cli_updates")
+
+    with patch.object(companion, "companion_cli_updates_enabled", return_value=False):
+        assert bound(gateway_mode=True) == []
