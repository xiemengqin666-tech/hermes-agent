+class _ThreadLocalEventLoopProxy:
+    """Route the Lark SDK's module-global loop to the calling WS thread.
+
+    ``lark_oapi.ws.client`` stores its event loop in a module global.  A
+    multi-account gateway runs one SDK client per thread, so assigning each
+    thread's loop directly to that global makes the clients overwrite one
+    another.  The next SDK reconnect then tries to await a Future owned by the
+    other account's loop.  A stable proxy keeps the SDK API unchanged while
+    resolving the actual loop from the current thread.
+    """
+
+    @staticmethod
+    def _current() -> asyncio.AbstractEventLoop:
+        return asyncio.get_event_loop()
+
+    def run_until_complete(self, future: Any) -> Any:
+        return self._current().run_until_complete(future)
+
+    def create_task(self, coroutine: Any) -> asyncio.Task:
+        return self._current().create_task(coroutine)
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._current(), name)
+
+
+_FEISHU_WS_LOOP_PROXY = _ThreadLocalEventLoopProxy()
+_FEISHU_WS_RUNTIME_CONTEXT = threading.local()
+_FEISHU_WS_HOOK_LOCK = threading.Lock()
