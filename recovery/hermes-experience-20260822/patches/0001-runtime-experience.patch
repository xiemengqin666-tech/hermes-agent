+        ws_client_module.loop = _FEISHU_WS_LOOP_PROXY
+        if getattr(ws_client_module, "_hermes_thread_local_hooks", False):
+            return
+
+        original_connect = ws_client_module.websockets.connect
+
+        @functools.wraps(original_connect)
+        def connect_with_runtime_overrides(*args: Any, **kwargs: Any) -> Any:
+            active_adapter = getattr(_FEISHU_WS_RUNTIME_CONTEXT, "adapter", None)
+            if active_adapter is not None:
