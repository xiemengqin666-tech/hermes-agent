+                if ping_timeout is not None and "ping_timeout" not in kwargs:
+                    kwargs["ping_timeout"] = ping_timeout
+            return original_connect(*args, **kwargs)
+
+        ws_client_module.websockets.connect = connect_with_runtime_overrides
+        ws_client_module._hermes_thread_local_hooks = True
