new file mode 100644
index 0000000000..be9843f072
--- /dev/null
+++ b/hermes_cli/update_readiness.py
@@ -0,0 +1,185 @@
+"""Preflight checks for safe, repeatable Hermes updates."""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Optional
+
+
+@dataclass(frozen=True)
+class UpdateReadiness:
+    ok: bool
+    summary: str
+    details: tuple[str, ...]
+    patch_count: int = 0
+    companion_clis: bool = False
+
+
+def _truthy(value, default: bool) -> bool:
+    if value is None:
+        return default
+    if isinstance(value, str):
+        return value.strip().lower() not in {"0", "false", "no", "off"}
+    return bool(value)
+
+
+def _update_settings(hermes_home: Path) -> tuple[bool, Path, bool]:
+    updates = {}
+    try:
+        import yaml
+
+        config_path = hermes_home / "config.yaml"
+        loaded = (
+            yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
+            if config_path.is_file()
+            else {}
+        )
+        candidate = loaded.get("updates", {})
+        if isinstance(candidate, dict):
+            updates = candidate
+    except Exception:
+        pass
+
+    patch_dir_env = os.environ.get("HERMES_UPDATE_PATCH_DIR", "").strip()
+    patch_dir_raw = patch_dir_env or str(updates.get("local_patch_dir", "") or "").strip()
+    patch_dir = Path(patch_dir_raw).expanduser() if patch_dir_raw else hermes_home / "update-patches"
+    patches_enabled = _truthy(updates.get("apply_local_patches"), True)
+    companion_clis = _truthy(updates.get("update_companion_clis"), False)
+    return patches_enabled, patch_dir, companion_clis
+
+
+def _run_git(project_root: Path, *args: str) -> subprocess.CompletedProcess[str]:
+    command = ["git"]
+    if os.name == "nt":
+        command.extend(["-c", "windows.appendAtomically=false"])
+    command.extend(args)
+    return subprocess.run(
+        command,
+        cwd=project_root,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+
+
+def _patch_works_in_tree(project_root: Path, patch: Path) -> bool:
+    patch_arg = str(patch)
+    reverse = _run_git(
+        project_root,
+        "apply",
+        "--reverse",
+        "--check",
+        "--whitespace=nowarn",
+        patch_arg,
+    )
+    if reverse.returncode == 0:
+        return True
+    forward = _run_git(
+        project_root,
+        "apply",
+        "--check",
+        "--whitespace=nowarn",
+        patch_arg,
+    )
+    return forward.returncode == 0
+
+
+def _patches_work_at_ref(
+    project_root: Path,
+    patches: list[Path],
+    target_ref: str,
+) -> tuple[bool, str]:
+    temp_root = Path(tempfile.mkdtemp(prefix="hermes-update-readiness-"))
+    worktree = temp_root / "target"
+    added = False
+    try:
+        add = _run_git(project_root, "worktree", "add", "--detach", str(worktree), target_ref)
+        if add.returncode != 0:
+            detail = (add.stderr or add.stdout).strip().splitlines()
+            return False, detail[-1] if detail else f"could not inspect {target_ref}"
+        added = True
+        for patch in patches:
+            check = _run_git(
+                worktree,
+                "apply",
+                "--check",
+                "--whitespace=nowarn",
+                str(patch),
+            )
+            if check.returncode != 0:
+                detail = (check.stderr or check.stdout).strip().splitlines()
+                reason = detail[-1] if detail else "patch does not apply"
+                return False, f"{patch.name} conflicts with target {target_ref}: {reason}"
+        return True, ""
+    finally:
+        if added:
+            _run_git(project_root, "worktree", "remove", "--force", str(worktree))
+        shutil.rmtree(temp_root, ignore_errors=True)
+
+
+def check_update_readiness(
+    *,
+    project_root: Optional[Path] = None,
+    hermes_home: Optional[Path] = None,
+    target_ref: Optional[str] = None,
+) -> UpdateReadiness:
+    """Validate the update command without mutating the active checkout."""
+    root = Path(project_root or Path(__file__).resolve().parent.parent)
+    if hermes_home is None:
+        try:
+            from hermes_constants import get_hermes_home
+
+            home = Path(get_hermes_home())
+        except Exception:
+            home = Path.home() / ".hermes"
+    else:
+        home = Path(hermes_home)
+
+    patches_enabled, patch_dir, companion_clis = _update_settings(home)
+    details: list[str] = []
+    if not (root / ".git").exists():
+        details.append("Hermes checkout is not a git repository")
+        return UpdateReadiness(False, "/update unavailable", tuple(details), 0, companion_clis)
+
+    unmerged = _run_git(root, "ls-files", "-u")
+    if unmerged.returncode != 0 or unmerged.stdout.strip():
+        details.append("git index contains unmerged files")
+
+    patches = (
+        sorted(path for path in patch_dir.glob("*.patch") if path.is_file())
+        if patches_enabled and patch_dir.is_dir()
+        else []
+    )
+    for patch in patches:
+        if not _patch_works_in_tree(root, patch):
+            details.append(f"local patch is neither cleanly applied nor applicable: {patch.name}")
+
+    if target_ref and not details and patches:
+        compatible, reason = _patches_work_at_ref(root, patches, target_ref)
+        if not compatible:
+            details.append(reason)
+
+    ok = not details
+    return UpdateReadiness(
+        ok=ok,
+        summary="/update ready" if ok else "/update unavailable",
+        details=tuple(details),
+        patch_count=len(patches),
+        companion_clis=companion_clis,
+    )
+
+
+def render_update_readiness_line(result: UpdateReadiness) -> str:
+    if result.ok:
+        cli_state = "enabled" if result.companion_clis else "disabled"
+        return (
+            f"✓ /update ready (local patches: {result.patch_count}; "
+            f"companion CLIs: {cli_state})"
+        )
+    detail = result.details[0] if result.details else "unknown validation failure"
+    return f"⚠ /update unavailable: {detail}"
